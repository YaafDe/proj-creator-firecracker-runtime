        try:
            path.unlink()
        except FileNotFoundError:
            pass

    cache_lock_path = warm_dir / "prepare.lock"
    with cache_lock_path.open("a+b") as cache_lock:
        fcntl.flock(cache_lock.fileno(), fcntl.LOCK_EX)
        cache_metadata = prepared_image_cache_metadata(warm_dir, selected_image_id)
        if cache_metadata is not None:
            emit_status("setup", "Cloning prepared agent image snapshot")
