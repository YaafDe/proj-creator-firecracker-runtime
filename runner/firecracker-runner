        wait_for_ssh(ssh_base, 120)
        prepared_id = resolve_loaded_guest_image(ssh_base, selected_image, load_result)
        flush_prepared_guest_filesystem(root_ssh_base)
        run(
            ["timeout", "15", *root_ssh_base, "bash", "-lc", shlex.quote(guest_shutdown_script())],
