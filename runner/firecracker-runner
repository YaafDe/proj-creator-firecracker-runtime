def log(message):
    try:
        print(message, file=sys.stderr, flush=True)
    except BrokenPipeError:
        # The runner CLI can exit before this process finishes cancellation.
        # Diagnostics are best-effort; a closed parent pipe must never abort
        # tap, NAT, API-socket, or Firecracker process cleanup.
        pass


def emit_status(phase, message):
    try:
        print(json.dumps({
            "type": "status",
            "phase": phase,
            "message": message,
        }, separators=(",", ":")), flush=True)
    except BrokenPipeError:
        # See log(): status delivery is less important than deterministic
        # teardown after cancellation or parent-process loss.
        pass


class RunnerInterrupted(Exception):
    def __init__(self, signum):
        super().__init__(f"received signal {signum}")
        self.signum = signum


def raise_runner_interrupted(signum, _frame):
    # Do not let a second termination signal interrupt resource cleanup. The
    # caller may still use SIGKILL after its grace period.
    signal.signal(signum, signal.SIG_IGN)
    raise RunnerInterrupted(signum)


def fail(message, code=70):
    log(f"firecracker-runner: {message}")
    raise SystemExit(code)


def require_command(name):
    path = shutil.which(name)
    if not path:
        fail(f"required command not found: {name}")
    return path


SENSITIVE_ASSIGNMENT_RE = re.compile(
    r"(?P<key>(?:[A-Za-z_][A-Za-z0-9_]*(?:_TOKEN|_KEY|_SECRET|_PASSWORD|_PASS|_CREDENTIAL|_CREDENTIALS)|PROMPT_B64|CODEX_RESUME_FALLBACK_PROMPT_B64))="
    r"(?P<value>'[^']*'|\"[^\"]*\"|[^\s'\";]+)"
)
BEARER_TOKEN_RE = re.compile(r"(?i)(bearer\s+)[A-Za-z0-9._~+/=-]+")


def redact_sensitive_text(value):
    value = SENSITIVE_ASSIGNMENT_RE.sub(lambda match: f"{match.group('key')}=<redacted>", value)
    return BEARER_TOKEN_RE.sub(r"\1<redacted>", value)


def format_command(command):
    parts = [str(part) for part in command]
    if len(parts) >= 3 and Path(parts[0]).name == "ssh" and parts[-3:-1] == ["bash", "-lc"]:
        parts = [*parts[:-1], "<remote-script>"]
    return redact_sensitive_text(shlex.join(parts))


def run(command, *, stdin=None, stdout=None, input_data=None, check=True):
    if stdin is not None and input_data is not None:
        raise ValueError("stdin and input_data are mutually exclusive")
    log("+ " + format_command(command))
    result = subprocess.run(
        command,
        stdin=stdin,
        stdout=stdout,
        input=input_data,
        check=False,
    )
    if check and result.returncode != 0:
        fail(f"command failed with exit code {result.returncode}: {format_command(command)}")
    return result


def run_privileged(command, *, check=True):
    if os.geteuid() == 0:
        return run(command, check=check)
    sudo = require_command("sudo")
    return run([sudo, *command], check=check)


def run_quiet(command, *, check=False):
    return subprocess.run(
        command,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def run_privileged_quiet(command, *, check=False):
    if os.geteuid() == 0:
        return run_quiet(command, check=check)
    sudo = require_command("sudo")
    return run_quiet([sudo, *command], check=check)


class UnixHttpConnection(http.client.HTTPConnection):
    def __init__(self, socket_path):
        super().__init__("localhost")
        self.socket_path = socket_path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(self.socket_path)


def firecracker_request(api_socket, method, path, body=None):
    conn = UnixHttpConnection(str(api_socket))
    payload = None if body is None else json.dumps(body).encode("utf-8")
    headers = {}
    if payload is not None:
        headers["Content-Type"] = "application/json"
    conn.request(method, path, body=payload, headers=headers)
    response = conn.getresponse()
    data = response.read().decode("utf-8", errors="replace")
    conn.close()
    if response.status >= 300:
        fail(f"Firecracker API {method} {path} failed with HTTP {response.status}: {data}")
    return data


def wait_for_path(path, seconds, label):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if Path(path).exists():
            return
        time.sleep(0.1)
    fail(f"timed out waiting for {label}: {path}")


def wait_for_ssh(ssh_base, seconds):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        result = subprocess.run([*ssh_base, "true"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if result.returncode == 0:
            return
        time.sleep(1)
    fail("timed out waiting for guest SSH")


def ssh_command(ssh_base, script, *, check=True, stdout=None, stdin=None):
    if stdin is not None:
        return run(
            [*ssh_base, "bash", "-lc", shlex.quote(script)],
            check=check,
            stdout=stdout,
            stdin=stdin,
        )
    return run(
        [*ssh_base, "bash", "-l", "-s"],
        check=check,
        stdout=stdout,
        input_data=script.encode("utf-8"),
    )


def ssh_output(ssh_base, script):
    command = [*ssh_base, "bash", "-l", "-s"]
    result = run(
        command,
        check=False,
        stdout=subprocess.PIPE,
        input_data=script.encode("utf-8"),
    )
    if result.returncode != 0:
        fail(f"command failed with exit code {result.returncode}: {format_command(command)}")
    return result.stdout.decode("utf-8", errors="replace")


def write_guest_file(ssh_base, destination, contents, mode="0600"):
    destination_q = shlex.quote(destination)
    mode_q = shlex.quote(mode)
    script = f"umask 077; cat > {destination_q}; chmod {mode_q} {destination_q}"
    return run(
        [*ssh_base, "bash", "-lc", shlex.quote(script)],
        input_data=contents,
    )


def stage_agent_script(ssh_base, agent_container_name, inner_script):
    guest_path = f"/tmp/{agent_container_name}-inner-script.sh"
    container_path = "/tmp/proj-creator-inner-script.sh"
    write_guest_file(ssh_base, guest_path, inner_script.encode("utf-8"))
    return (
        ["-v", f"{guest_path}:{container_path}:ro"],
        ["/bin/bash", "-l", container_path],
    )


def docker_service_args(required, socket_gid):
    if not required:
        return []
    socket_gid = str(socket_gid).strip()
    if not socket_gid.isdigit():
        fail(f"guest Docker socket has invalid group id: {socket_gid!r}")
    return [
        "-v", "/var/run/docker.sock:/var/run/docker.sock",
        "--group-add", socket_gid,
    ]


def agent_container_identity_args(request):
    args = ["--label", "proj-creator.runtime-role=agent"]
    for request_key, label_key in [
        ("conversation_id", "proj-creator.conversation-id"),
        ("message_id", "proj-creator.message-id"),
    ]:
        value = request.get(request_key)
        if value:
            args.extend(["--label", f"{label_key}={value}"])
    return args


def terminate_process(process, name):
    if process.poll() is not None:
        return
    process.terminate()
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        log(f"{name} did not exit after terminate; killing")
        process.kill()
        process.wait(timeout=5)


def tar_to_guest(ssh_base, source, destination):
    script = f"mkdir -p {shlex.quote(destination)} && tar -C {shlex.quote(destination)} -xf -"
    tar = subprocess.Popen(["tar", "-C", str(source), "-cf", "-", "."], stdout=subprocess.PIPE)
    try:
        ssh_command(ssh_base, script, stdin=tar.stdout)
    finally:
        if tar.stdout:
            tar.stdout.close()
    status = tar.wait()
    if status != 0:
        fail(f"workspace tar export failed with exit code {status}")


def chown_guest_workspace(root_ssh_base, destination, uid, gid):
    destination_q = shlex.quote(destination)
    owner_q = shlex.quote(f"{uid}:{gid}")
    ssh_command(root_ssh_base, f"chown -R {owner_q} {destination_q}")
    log(f"guest workspace ownership set to {uid}:{gid}: {destination}")


def chown_host_path(destination, uid, gid):
    run_privileged(["chown", "-R", f"{uid}:{gid}", str(destination)])
    log(f"host workspace ownership set to {uid}:{gid}: {destination}")


def container_workspace_target(workdir):
    if workdir.startswith("/workspace/"):
        return "/workspace"
    if workdir.startswith("/"):
        return workdir
    return f"/workspace/{workdir}"


def sync_host_path_to_guest(root_ssh_base, host_path, guest_path, uid, gid):
    host = Path(host_path)
    if not host.exists():
        fail(f"Firecracker support mount source does not exist: {host_path}")

    guest_path_q = shlex.quote(guest_path)
    if host.is_dir():
        script = f"mkdir -p {guest_path_q} && tar -C {guest_path_q} -xf -"
        tar = subprocess.Popen(["tar", "-C", str(host), "-cf", "-", "."], stdout=subprocess.PIPE)
        try:
            ssh_command(root_ssh_base, script, stdin=tar.stdout)
        finally:
            if tar.stdout:
                tar.stdout.close()
        status = tar.wait()
        if status != 0:
            fail(f"support mount tar export failed with exit code {status}: {host_path}")
    else:
        mode = host.stat().st_mode & 0o777
        parent_q = shlex.quote(str(Path(guest_path).parent))
        with host.open("rb") as source:
            ssh_command(
                root_ssh_base,
                f"mkdir -p {parent_q} && cat > {guest_path_q} && chmod {mode:o} {guest_path_q}",
                stdin=source,
            )
    chown_guest_workspace(root_ssh_base, guest_path, uid, gid)


def tar_from_guest(ssh_base, source, destination):
    tar = subprocess.Popen(["tar", "-C", str(destination), "-xf", "-"], stdin=subprocess.PIPE)
    try:
        script = f"tar --exclude=.git -C {shlex.quote(source)} -cf - ."
        ssh_command(ssh_base, script, stdout=tar.stdin)
    finally:
        if tar.stdin:
            tar.stdin.close()
    status = tar.wait()
    if status != 0:
        fail(f"workspace tar import failed with exit code {status}")


def fetch_guest_file(ssh_base, source, destination):
    source_q = shlex.quote(source)
    destination.parent.mkdir(parents=True, exist_ok=True)
    with destination.open("wb") as output:
        result = ssh_command(
            ssh_base,
            f"if [ -f {source_q} ]; then cat {source_q}; fi",
            check=False,
            stdout=output,
        )
    if result.returncode != 0:
        log(f"failed to fetch guest file {source}: ssh exited {result.returncode}")


def sync_mount_back_to_host(root_ssh_base, mount, uid, gid):
    if mount.get("read_only"):
        return
    purpose = str(mount.get("purpose") or "")
    if purpose not in {"runtime_support", "claude_session", "codex_session"}:
        return
    host_path = Path(str(mount.get("host_path") or ""))
    guest_path = str(mount.get("guest_path") or "")
    if not host_path.is_dir() or not guest_path:
        return
    log(f"syncing Firecracker support mount back from guest {guest_path} to {host_path}")
    tar_from_guest(root_ssh_base, guest_path, host_path)
    chown_host_path(host_path, uid, gid)


def parse_docker_load_output(output):
    loaded_image_id = None
    loaded_references = []
    for line in output.splitlines():
        if line.startswith("Loaded image ID: "):
            candidate = line.removeprefix("Loaded image ID: ").strip()
            if re.fullmatch(r"sha256:[0-9a-f]{64}", candidate):
                loaded_image_id = candidate
        elif line.startswith("Loaded image: "):
            candidate = line.removeprefix("Loaded image: ").strip()
            if candidate:
                loaded_references.append(candidate)
    return loaded_image_id, loaded_references


def resolve_loaded_guest_image(ssh_base, selected_image, load_result):
    loaded_image_id, loaded_references = load_result
    candidates = [loaded_image_id, *loaded_references, selected_image]
    for candidate in candidates:
        if not candidate:
            continue
        guest_image_id = guest_docker_image_id(ssh_base, candidate)
        if guest_image_id:
            return guest_image_id
    fail(f"guest Docker did not retain the imported image: {selected_image}")


def load_docker_image_to_guest(ssh_base, image, image_id=None):
    source_image = image_id or image
    run(["docker", "image", "inspect", source_image], stdout=subprocess.DEVNULL)
    timeout_seconds = int(os.environ.get("PROJ_CREATOR_FIRECRACKER_DOCKER_LOAD_TIMEOUT_SECONDS", "900"))
    save = subprocess.Popen(["docker", "save", source_image], stdout=subprocess.PIPE)
    ssh = None
    with tempfile.TemporaryFile() as guest_stdout:
        try:
            ssh = subprocess.Popen(
                [*ssh_base, "bash", "-lc", shlex.quote("docker load")],
                stdin=save.stdout,
                stdout=guest_stdout,
            )
            if save.stdout:
                save.stdout.close()
            deadline = time.monotonic() + timeout_seconds
            while True:
                save_status = save.poll()
                ssh_status = ssh.poll()
                if save_status is not None and ssh_status is not None:
                    break
                if time.monotonic() > deadline:
                    terminate_process(save, "docker save")
                    terminate_process(ssh, "guest docker load")
                    fail(f"timed out after {timeout_seconds}s loading Docker image into guest: {image}")
                time.sleep(0.5)
        finally:
            if save.stdout:
                save.stdout.close()
            if ssh is not None:
                terminate_process(ssh, "guest docker load")
        status = save.wait()
        if status != 0:
            fail(f"docker save failed with exit code {status}: {image}")
        ssh_status = ssh.wait() if ssh is not None else 1
        if ssh_status != 0:
            fail(f"guest docker load failed with exit code {ssh_status}: {image}")
        guest_stdout.seek(0)
        load_output = guest_stdout.read().decode("utf-8", errors="replace")

    for line in load_output.splitlines():
        try:
            print(line, flush=True)
        except BrokenPipeError:
            break
    load_result = parse_docker_load_output(load_output)
    if not load_result[0] and not load_result[1]:
        fail(f"guest docker load did not report an imported image: {image}")
    return load_result


def host_docker_image_id(image):
    result = run(
        ["docker", "image", "inspect", "--format", "{{.Id}}", image],
        stdout=subprocess.PIPE,
    )
    image_id = result.stdout.decode("utf-8", errors="replace").strip()
    if not image_id:
        fail(f"Docker returned an empty immutable image ID for {image}")
    return image_id


def guest_docker_image_id(ssh_base, image):
    result = ssh_command(
        ssh_base,
        f"docker image inspect --format '{{{{.Id}}}}' {shlex.quote(image)}",
        check=False,
        stdout=subprocess.PIPE,
    )
    if result.returncode != 0:
        return None
    return result.stdout.decode("utf-8", errors="replace").strip() or None


def load_image_and_stage_workspace(
    ssh_base,
    root_ssh_base,
    image,
    repo,
    guest_workspace,
    workspace_uid,
    workspace_gid,
    selected_image_id=None,
    warm_dir=None,
    expected_guest_image_id=None,
):
    guest_image_id = None
    if expected_guest_image_id:
        guest_image_id = guest_docker_image_id(ssh_base, expected_guest_image_id)
    elif selected_image_id:
        candidate = guest_docker_image_id(ssh_base, image)
        if candidate == selected_image_id:
            guest_image_id = candidate

    if guest_image_id:
        emit_status("run", "Using prepared agent image snapshot")
        log(f"agent image already present in guest: {image} ({guest_image_id})")
    else:
        if warm_dir is not None and Path(warm_dir, "prepared.json").exists():
            log("prepared agent image snapshot did not contain the expected image; invalidating it")
            try:
                Path(warm_dir, "prepared.json").unlink()
            except FileNotFoundError:
                pass
        log(f"loading agent image into guest: {image}")
        load_result = load_docker_image_to_guest(ssh_base, image, selected_image_id)

        # Importing a large image can leave the guest CPU and filesystem busy
        # long enough for sshd to miss the short per-attempt SSH banner timeout.
        emit_status("run", "Waiting for guest SSH after image load")
        wait_for_ssh(ssh_base, 120)
        guest_image_id = resolve_loaded_guest_image(ssh_base, image, load_result)

    emit_status("workspace", "Staging workspace into guest")
    log(f"staging workspace into guest {guest_workspace}")
    tar_to_guest(ssh_base, repo, guest_workspace)
    chown_guest_workspace(
        root_ssh_base,
        guest_workspace,
        workspace_uid,
        workspace_gid,
    )
    return guest_image_id


def parse_size(value):
    value = value.strip()
    if not value:
        fail("empty rootfs size")
    suffix = value[-1].upper()
    multipliers = {"K": 1024, "M": 1024 ** 2, "G": 1024 ** 3, "T": 1024 ** 4}
    if suffix in multipliers:
        return int(float(value[:-1]) * multipliers[suffix])
    return int(value)


def grow_rootfs(rootfs):
    target_size = os.environ.get("PROJ_CREATOR_FIRECRACKER_RUN_ROOTFS_SIZE", "50G")
    target_bytes = parse_size(target_size)
    current_bytes = rootfs.stat().st_size
    if current_bytes >= target_bytes:
        log(f"rootfs already {current_bytes} bytes; target is {target_size}")
        return
    log(f"growing run rootfs from {current_bytes} bytes to {target_size}")
    run(["truncate", "-s", target_size, str(rootfs)])
    run(["e2fsck", "-fy", str(rootfs)])
    run(["resize2fs", str(rootfs)])


def allow_full_copy_fallback():
    return os.environ.get("PROJ_CREATOR_FIRECRACKER_ALLOW_FULL_COPY", "").strip().lower() in {
        "1", "true", "yes", "on"
    }


def clone_rootfs(source, destination):
    source = Path(source)
    destination = Path(destination)
    destination.parent.mkdir(parents=True, exist_ok=True)
    result = run(
        ["cp", "--reflink=always", str(source), str(destination)],
        check=False,
    )
    if result.returncode == 0:
        return "reflink"
    if not allow_full_copy_fallback():
        fail(
            "Firecracker prepared image snapshots require copy-on-write reflink support "
            f"from {source} to {destination}"
        )
    shutil.copyfile(source, destination)
    return "copy"


def prepared_image_cache_metadata(warm_dir, selected_image_id):
    warm_dir = Path(warm_dir)
    rootfs = warm_dir / "rootfs.ext4"
    marker = warm_dir / "prepared.json"
    if not rootfs.is_file() or not marker.is_file():
        return None
    try:
        metadata = json.loads(marker.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if metadata.get("selected_image_id") != selected_image_id:
        return None
    guest_image_id = metadata.get("guest_image_id")
    if not isinstance(guest_image_id, str) or not re.fullmatch(r"sha256:[0-9a-f]{64}", guest_image_id):
        return None
    return metadata


def prepared_image_cache_ready(warm_dir, selected_image_id):
    return prepared_image_cache_metadata(warm_dir, selected_image_id) is not None


def replace_run_rootfs_from_cache(rootfs, warm_dir):
    rootfs = Path(rootfs)
    cached_rootfs = Path(warm_dir) / "rootfs.ext4"
    temporary = rootfs.with_name(f"{rootfs.name}.cache-{os.getpid()}")
    try:
        temporary.unlink()
    except FileNotFoundError:
        pass
    clone_mode = clone_rootfs(cached_rootfs, temporary)
    os.replace(temporary, rootfs)
    return clone_mode


def rootfs_user_ids(mount_dir, user):
    passwd_path = mount_dir / "etc" / "passwd"
    try:
        with passwd_path.open("r", encoding="utf-8") as passwd:
            for line in passwd:
                fields = line.rstrip("\n").split(":")
                if len(fields) >= 4 and fields[0] == user:
                    return fields[2], fields[3]
    except OSError as err:
        fail(f"failed to read guest passwd database {passwd_path}: {err}")
    fail(f"guest user not found in {passwd_path}: {user}")


def inject_ssh_key(rootfs, mount_dir, public_key):
    run_privileged(["mount", "-o", "loop", str(rootfs), str(mount_dir)])
    try:
        for user, home in [
            ("root", "root"),
            ("appuser", "home/appuser"),
        ]:
            uid, gid = rootfs_user_ids(mount_dir, user)
            ssh_dir = mount_dir / home / ".ssh"
            authorized_keys = ssh_dir / "authorized_keys"
            run_privileged(["mkdir", "-p", str(ssh_dir)])
            run_privileged(["sh", "-c", f"printf '%s\n' {shlex.quote(public_key)} >> {shlex.quote(str(authorized_keys))}"])
            run_privileged(["chmod", "0700", str(ssh_dir)])
            run_privileged(["chmod", "0600", str(authorized_keys)])
            run_privileged(["chown", "-R", f"{uid}:{gid}", str(ssh_dir)])
            log(f"injected SSH key for {user}")
    finally:
        run_privileged(["umount", str(mount_dir)], check=False)


def sanitize_prepared_rootfs(rootfs, mount_dir, public_key):
    run_privileged(["mount", "-o", "loop", str(rootfs), str(mount_dir)])
    try:
        for home in ["root", "home/appuser"]:
            authorized_keys = mount_dir / home / ".ssh" / "authorized_keys"
            script = (
                f"file={shlex.quote(str(authorized_keys))}; "
                f"key={shlex.quote(public_key)}; "
                "if [ -f \"$file\" ]; then "
                "tmp=${file}.proj-creator-tmp; "
                "grep -Fvx -- \"$key\" \"$file\" > \"$tmp\" || true; "
                "cat \"$tmp\" > \"$file\"; rm -f \"$tmp\"; fi"
            )
            run_privileged(["sh", "-c", script])
        ssh_dir = mount_dir / "etc" / "ssh"
        script = (
            f"dir={shlex.quote(str(ssh_dir))}; "
            "for file in \"$dir\"/ssh_host_*; do "
            "[ ! -e \"$file\" ] || rm -f -- \"$file\"; done"
        )
        run_privileged(["sh", "-c", script])
    finally:
        run_privileged(["umount", str(mount_dir)], check=False)


def stable_network(run_dir):
    digest = hashlib.sha256(str(run_dir).encode("utf-8")).digest()
    octet = 16 + digest[0] % 200
    host_ip = f"172.31.{octet}.1"
    guest_ip = f"172.31.{octet}.2"
    mac = f"06:00:ac:1f:{octet:02x}:02"
    tap = f"pcfc{digest[1]:02x}{digest[2]:02x}{digest[3]:02x}"[:15]
    return tap, host_ip, guest_ip, mac


def guest_subnet(host_ip):
    return ".".join(host_ip.split(".")[:3]) + ".0/24"


def iptables_rule_exists(args):
    return run_privileged_quiet(["iptables", *args], check=False).returncode == 0


def ensure_iptables_rule(table, chain, rule):
    check_args = []
    if table:
        check_args.extend(["-t", table])
    check_args.extend(["-C", chain, *rule])
    delete_args = []
    if table:
        delete_args.extend(["-t", table])
    delete_args.extend(["-D", chain, *rule])
    cleanup_command = ["iptables", *delete_args]
    if iptables_rule_exists(check_args):
        # The rule is namespaced by this deterministic per-run tap/subnet. It
        # can be left behind by an earlier hard kill, so the current run owns
        # removing it even when it did not need to recreate it.
        return cleanup_command

    add_args = []
    if table:
        add_args.extend(["-t", table])
    add_args.extend(["-A", chain, *rule])
    run_privileged(["iptables", *add_args])
    return cleanup_command


def setup_guest_nat(tap, host_ip):
    require_command("iptables")
    require_command("sysctl")
    subnet = guest_subnet(host_ip)
    run_privileged(["sysctl", "-w", "net.ipv4.ip_forward=1"])
    cleanup = []
    try:
        for table, chain, rule in [
            ("nat", "POSTROUTING", ["-s", subnet, "!", "-o", tap, "-j", "MASQUERADE"]),
            (None, "FORWARD", ["-i", tap, "-j", "ACCEPT"]),
            (
                None,
                "FORWARD",
                ["-o", tap, "-m", "conntrack", "--ctstate", "RELATED,ESTABLISHED", "-j", "ACCEPT"],
            ),
        ]:
            cleanup.append(ensure_iptables_rule(table, chain, rule))
    except BaseException:
        cleanup_guest_nat(cleanup)
        raise
    log(f"guest NAT enabled for {subnet} via {tap}")
    return cleanup


def cleanup_guest_nat(cleanup_commands):
    for command in reversed(cleanup_commands):
        run_privileged(command, check=False)


