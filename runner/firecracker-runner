                run_dir,
                selected_image,
                selected_image_id,
            )
            replace_run_rootfs_from_cache(rootfs, warm_dir)
            cache_metadata = prepared_image_cache_metadata(warm_dir, selected_image_id)
            if cache_metadata is None:
