    clone_mode = clone_rootfs(rootfs, temporary_rootfs)
    metadata = {
        "format_version": 2,
        "selected_image": selected_image,
        "selected_image_id": selected_image_id,
        "guest_image_id": prepared_id,
        "clone_mode": clone_mode,
        "prepared_at_unix": int(time.time()),
    }
    temporary_marker.write_text(json.dumps(metadata, indent=2) + "\n", encoding="utf-8")
    os.replace(temporary_rootfs, warm_dir / "rootfs.ext4")
    os.replace(temporary_marker, marker)
    emit_status("setup", "Published reusable agent image snapshot")


def run_request(request):
    contract_version = int(request.get("contract_version", 1))
    if contract_version != 1:
        fail(f"unsupported Firecracker runner contract version: {contract_version}")
    rootfs = Path(request["rootfs"]).resolve()
    kernel = Path(request["kernel_image"]).resolve()
    run_dir = Path(request["run_dir"]).resolve()
