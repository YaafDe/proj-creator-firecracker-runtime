    try:
        marker.unlink()
    except FileNotFoundError:
        pass
    temporary_rootfs = warm_dir / f"rootfs.ext4.tmp-{os.getpid()}"
    temporary_marker = warm_dir / f"prepared.json.tmp-{os.getpid()}"
    for path in [temporary_rootfs, temporary_marker]:
